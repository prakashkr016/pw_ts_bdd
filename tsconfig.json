{
    "compilerOptions": {
        "target": "ES2022",
        "module": "esnext",
        "moduleResolution": "bundler",
        "strict": true,
        "types": [
            "node"
        ],
        "noEmit": true,
        "skipLibCheck": true,
        "resolveJsonModule": true,
        "forceConsistentCasingInFileNames": true,
        "paths": {
            "@pages/*": [
                "./src/pages/*"
            ],
            "@components/*": [
                "./src/components/*"
            ],
            "@api/*": [
                "./src/api/*"
            ],
            "@fixtures/*": [
                "./src/fixtures/*"
            ],
            "@data/*": [
                "./src/data/*"
            ],
            "@utils/*": [
                "./src/utils/*"
            ],
            "@config/*": [
                "./config/*"
            ],
            "@steps/*": [
                "./src/steps/*"
            ],
            "@features/*": [
                "./src/features/*"
            ],
        }
    },
    "include": [
        "src/**/*.ts",
        "tests/**/*.ts",
        "config/**/*.ts",
        "playwright.config.ts"
    ],
    "exclude": [
        "node_modules"
    ]
}